# Copy to api/.env and fill in. api/.env is git-ignored. Never commit real values.

NK_ENVIRONMENT=local
NK_PORT=8000

# Microsoft Foundry model deployment (Foundry portal > Home).
# Endpoint: the "Azure OpenAI endpoint", e.g. https://<resource>.openai.azure.com/
NK_LLM_ENDPOINT=
NK_LLM_API_KEY=
NK_LLM_DEPLOYMENT=

# Azure AI Speech. The Foundry resource's API key and region work here too.
NK_SPEECH_REGION=
NK_SPEECH_KEY=
